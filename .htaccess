# Apache configuration for signiasolutions.com
#
# Use this file if the site is served by Apache (most cPanel / shared hosts,
# and the likely setup if you drop this in place of the WordPress install).
# On Netlify or Cloudflare Pages this file is ignored — _redirects and _headers
# do the same jobs there.

# ---------------------------------------------------------------------------
# Canonical host + HTTPS
# Pick ONE canonical hostname and send everything else to it with a 301.
# Serving the same page on both www and non-www splits your ranking signals.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force non-www (swap the two lines below if you prefer www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ------------------------------------------------------------------------
  # Legacy WordPress URLs → new paths.
  # Without these, every existing bookmark, email signature and directory
  # listing pointing at the old slugs lands on a 404.
  # ------------------------------------------------------------------------
  RewriteRule ^who/?$              /who-we-are/    [R=301,L]
  RewriteRule ^triage/?$           /nurse-triage/  [R=301,L]
  RewriteRule ^v42-home/?$         /               [R=301,L]

  # Old WordPress endpoints have nothing to serve on a static site.
  RewriteRule ^wp-admin(/.*)?$     /               [R=301,L]
  RewriteRule ^wp-login\.php$      /               [R=301,L]
  RewriteRule ^xmlrpc\.php$        /               [R=301,L]
  RewriteRule ^feed/?$             /               [R=301,L]
  RewriteRule ^comments/feed/?$    /               [R=301,L]

  # Serve /page/ from /page/index.html without exposing the filename.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # Build inputs are not web content.
  RewriteRule ^tools/ - [F,L]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers (see _headers for the Netlify/Cloudflare equivalents)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self' https:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ---------------------------------------------------------------------------
# Compression — the single biggest Core Web Vitals win on a static site
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

# Correct MIME types (some shared hosts still miss these)
<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType image/svg+xml             .svg
  AddType application/manifest+json .webmanifest
</IfModule>
